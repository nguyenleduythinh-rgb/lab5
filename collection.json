          "name": "duplicate user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 422\", () => pm.response.to.have.status(422));\r\npm.test(\"Email đã tồn tại\", () => {\r\n  const b = pm.response.json()[0];\r\n  pm.expect(b.field).to.eql(\"email\");\r\n  pm.expect(b.message).to.include(\"taken\");\r\n});\r\n\r\nconst tid = pm.environment.get(\"tempId\");\r\nif (tid) {\r\n  pm.sendRequest({\r\n    url: pm.environment.get(\"baseURL\") + \"/public/v2/users/\" + tid,\r\n    method: \"DELETE\",\r\n    header: { \"Authorization\": \"Bearer \" + pm.environment.get(\"token\") }\r\n  });\r\n  pm.environment.unset(\"tempId\");\r\n}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({\r\n  url: pm.environment.get(\"baseURL\") + \"/public/v2/users\",\r\n  method: \"POST\",\r\n  header: {\r\n    \"Authorization\": \"Bearer \" + pm.environment.get(\"token\"),\r\n    \"Content-Type\": \"application/json\"\r\n  },\r\n  body: { mode: \"raw\", raw: JSON.stringify({\r\n    name: pm.environment.get(\"name\"),\r\n    gender: pm.environment.get(\"gender\"),\r\n    email: pm.environment.get(\"email\"),\r\n    status: \"active\"\r\n  })}\r\n}, (err, res) => {\r\n  if (!err && res.code === 201) pm.environment.set(\"tempId\", res.json().id);\r\n});"
                ]
              }
            }
