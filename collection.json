                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));\nconst res = pm.response.json();\npm.environment.set(\"userID\", res.id);\npm.test(\"Email khớp\", () => pm.expect(res.email).to.eql(pm.environment.get(\"email\")));"
