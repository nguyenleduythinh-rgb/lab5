                "exec": [
                  "const users = [\r\n  { name: \"Nguyen Van A\", gender: \"male\",   status: \"active\" },\r\n  { name: \"Tran Thi B\",   gender: \"female\", status: \"active\" },\r\n  { name: \"Le Van C\",     gender: \"male\",   status: \"active\" }\r\n];\r\nconst i = pm.info.iteration % users.length;\r\nconst u = users[i];\r\npm.environment.set(\"name\", u.name);\r\npm.environment.set(\"gender\", u.gender);\r\npm.environment.set(\"status\", u.status);\r\npm.environment.set(\"email\", `user${i + 1}_${Date.now()}@example.com`);"
                ]
